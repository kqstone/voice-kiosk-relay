<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Top Header Area (Screenshot 5) -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <!-- Title Row: Dot + Title + Tag Pill + Spacer + Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Purple Accent Dot -->
                <View
                    android:id="@+id/viewAccentDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_board_dot" />

                <!-- Board Main Title -->
                <TextView
                    android:id="@+id/tvBoardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/title_text_size" />

                <!-- Tag Pill -->
                <TextView
                    android:id="@+id/tvBoardTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_board_tag"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Badge Pill -->
                <TextView
                    android:id="@+id/tvBoardBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_board_badge"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/accent_purple_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Subtitle Description -->
            <TextView
                android:id="@+id/tvBoardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/subtitle_text_size"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Content RecyclerView: Two columns in landscape grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBoardContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp" />

    </LinearLayout>

</FrameLayout>
