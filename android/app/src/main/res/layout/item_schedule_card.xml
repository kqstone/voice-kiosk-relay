<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/task_card_margin_h"
    android:layout_marginTop="@dimen/task_card_margin_v"
    android:layout_marginEnd="@dimen/task_card_margin_h"
    android:layout_marginBottom="@dimen/task_card_margin_v"
    android:background="@drawable/bg_task_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/card_padding">

    <!-- Left Content: Category row (dot + label + target time + recurrence tag) and title -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Top metadata row: dot + label + target time tag + recurrence tag -->
        <LinearLayout
            android:id="@+id/categoryRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewCategoryDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_board_dot" />

            <TextView
                android:id="@+id/tvCategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Time tag (e.g. 今天 07:00 / 明天 14:30) -->
            <TextView
                android:id="@+id/tvTargetTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/accent_purple_text"
                android:textSize="13sp" />

            <!-- Recurrence tag (e.g. 工作日 / 每天) -->
            <TextView
                android:id="@+id/tvRecurrenceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_board_tag"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:textColor="#C4B5FD"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Item Title Text -->
        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/task_text_size" />

    </LinearLayout>

    <!-- Delete Button -->
    <FrameLayout
        android:id="@+id/btnDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="删除事项"
            android:src="@drawable/ic_schedule_delete" />

    </FrameLayout>

    <!-- Right Side: Circular Checkbox Container (Toggle Complete) -->
    <FrameLayout
        android:id="@+id/checkboxContainer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/ivCheckbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="完成状态"
            android:src="@drawable/ic_checkbox_unchecked" />

    </FrameLayout>

</LinearLayout>
