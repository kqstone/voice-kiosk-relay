<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Top Status Row -->
    <LinearLayout
        android:id="@+id/listeningTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Status Dot + Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/viewListeningDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_listening_dot" />

            <TextView
                android:id="@+id/tvListeningStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="正在聆听..."
                android:textColor="@color/accent_cyan_bright"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Close Button (✕) -->
        <TextView
            android:id="@+id/btnCloseOverlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_overlay_close"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_white"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Center Content: User Speech / Thinking / Assistant Reply -->
    <LinearLayout
        android:id="@+id/listeningCenterContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvListeningSpeech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="“请讲，我在听...”"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:id="@+id/tvListeningReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_task_card"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:maxLines="6"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom Suggestion Area -->
    <LinearLayout
        android:id="@+id/listeningBottomContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="44dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvSuggestionPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="点击模拟语音指令测试对话流光："
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 2x2 Grid: Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipCommand1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_command"
                android:gravity="center"
                android:minHeight="42dp"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="“今天天气怎么样？”"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/chipCommand2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_command"
                android:gravity="center"
                android:minHeight="42dp"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="“把第一项任务标为已完成”"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 2x2 Grid: Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipCommand3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_command"
                android:gravity="center"
                android:minHeight="42dp"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="“查看今日待办事项”"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/chipCommand4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_command"
                android:gravity="center"
                android:minHeight="42dp"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="“切换下一首音乐”"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
