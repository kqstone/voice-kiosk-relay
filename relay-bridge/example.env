# Relay Bridge Configuration
PORT=8093
TZ=Asia/Shanghai
DATA_DIR=/app/data

# Authentication tokens (placeholders only - replace in .env)
PUSH_TOKEN=placeholder-push-token
DEVICE_TOKEN=placeholder-device-token

# LLM settings (Bridge fast answer)
# REQUIRED: server fails fast at startup if LLM_BASE_URL or LLM_MODEL is missing or empty
LLM_BASE_URL=http://your-llm-service-host:port
LLM_MODEL=your-llm-model-name
LLM_API_KEY=placeholder-llm-key

# Search settings (Tavily search client)
TAVILY_API_KEY=placeholder-tavily-key
SEARCH_ENABLED=true
SEARCH_TIMEOUT=2.5
SEARCH_MAX_RESULTS=3
# TAVILY_API_URL=https://api.tavily.com/search
