# ==============================================================================
# Voice Kiosk Relay Bridge - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in production and customize for your deployment.
#
# HARD RULES:
# - Never commit real API keys, server addresses, internal domains, or tokens.
# - All deployment values come from environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Storage Settings
# ------------------------------------------------------------------------------
# Server listening port (default: 8093)
PORT=8093

# System timezone for logs, board dates, and timestamps (default: Asia/Shanghai)
TZ=Asia/Shanghai

# Base data directory inside container or local environment (default: /app/data)
# In Docker, this is mounted to a host volume to ensure persistence across container rebuilds.
DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 2. Authentication Tokens
# ------------------------------------------------------------------------------
# Bearer token for push and conversation reply endpoints (optional in local dev, recommended in prod)
PUSH_TOKEN=placeholder-push-token

# Bearer token for Android kiosk device authentication (/api/v1/chat, /api/v1/memory/*)
DEVICE_TOKEN=placeholder-device-token

# ------------------------------------------------------------------------------
# 3. LLM Settings (Fast Answer Bridge)
# ------------------------------------------------------------------------------
# REQUIRED: Base URL of the OpenAI-compatible chat completions service.
# The server verifies this on startup and FAILS FAST (RuntimeError) if missing or empty.
# Example format: http://hostname:port or https://api.example.com
LLM_BASE_URL=http://your-llm-service-host:port

# REQUIRED: Model identifier to use for bridge fast-answer responses.
# The server verifies this on startup and FAILS FAST (RuntimeError) if missing or empty.
# Example format: your-chat-model-name
LLM_MODEL=your-llm-model-name

# API key for upstream LLM service (optional if proxy does not require auth)
LLM_API_KEY=placeholder-llm-key

# ------------------------------------------------------------------------------
# 4. Web Search Settings (Tavily Grounding)
# ------------------------------------------------------------------------------
# Tavily API key for real-time web search (weather, news, realtime data).
# If empty or invalid, the bridge gracefully degrades to offline answers without raising errors.
TAVILY_API_KEY=placeholder-tavily-key

# Tavily search API endpoint (default: https://api.tavily.com/search)
TAVILY_API_URL=https://api.tavily.com/search

# Enable or disable real-time web search grounding (default: true)
SEARCH_ENABLED=true

# Request timeout in seconds for external web search (default: 2.5)
SEARCH_TIMEOUT=2.5

# Maximum search results to inject into the system prompt (default: 3)
SEARCH_MAX_RESULTS=3

# Maximum search queries allowed per rolling 1-hour window to protect quota (default: 60)
SEARCH_HOURLY_LIMIT=60

# ------------------------------------------------------------------------------
# 5. Long-Term Memory Settings (Android Subsystem Integration)
# ------------------------------------------------------------------------------
# Enable or disable long-term memory retrieval and prompt injection (default: true)
MEMORY_ENABLED=true

# Custom SQLite database path (default: ${DATA_DIR}/memory.db)
# Persisted in the mounted DATA_DIR volume so it survives container recreation.
MEMORY_DB_PATH=/app/data/memory.db
